---
import '@/styles/global.css';
import SiteNav from '@/components/nav/SiteNav.astro';
import SiteFooter from '@/components/nav/SiteFooter.astro';
import CookieConsentBanner from '@/components/CookieConsentBanner.astro';
import { LOCALES, localeAlternates, localeToHtmlLang, localeUrlSegment, stripLocaleSegment, type Locale } from '@/lib/i18n';
import { t } from '@/i18n';

interface Props {
  locale: string;
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  /** Page colour scheme. 'dark' gives the nav its dark styling and paints the
      document canvas navy, so over-scroll bounce never shows a light gap. */
  theme?: 'light' | 'dark';
}

const { locale } = Astro.props;
const {
  title = t(locale, 'Seo.siteName'),
  description = t(locale, 'Seo.siteDescription'),
  canonical: canonicalProp,
  ogType = 'website',
  twitterCard = 'summary',
  theme = 'light',
} = Astro.props;

const htmlLang = localeToHtmlLang(locale);
const siteName = t(locale, 'Seo.siteName');

// Canonical + hreflang alternates. Astro.url is the request URL; site is the
// canonical origin from astro.config.mjs. Strip the locale segment to get the
// locale-neutral path, then rebuild a URL per locale. Alternates are emitted
// only for locales that really have this page: full-coverage locales except on
// pages without a zh-Hant twin (`NO_ZH_HANT_PATHS`), partial locales just on their translated
// paths, plus the current locale itself. Market-specific pages (`TRANSLATION_SETS`)
// carry a different slug per locale and have no English version, so each
// alternate brings its own path and `x-default` is omitted.
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pathname = Astro.url.pathname;
const neutralPath = stripLocaleSegment(pathname) || '/';
const urlFor = (loc: string, path: string = neutralPath) =>
  `${siteOrigin}${localeUrlSegment(loc)}${path === '/' ? '/' : path}`;
const alternates = localeAlternates(neutralPath);
const alternateLocales = alternates.some((alt) => alt.locale === locale)
  ? alternates
  : [...alternates, { locale: locale as Locale, path: neutralPath }];
const enUrl = alternates.find((alt) => alt.locale === 'en')?.path ? urlFor('en') : null;
const canonical = canonicalProp ?? urlFor(LOCALES.includes(locale as Locale) ? locale : 'en');
const OG_LOCALES: Record<string, string> = { en: 'en_US', 'zh-Hant': 'zh_TW', ja: 'ja_JP', es: 'es_ES', de: 'de_DE', fr: 'fr_FR' };
const ogLocale = OG_LOCALES[locale] ?? 'en_US';
const ogLocaleAlternate = locale === 'en' ? 'zh_TW' : 'en_US';
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '';

const fontFamilies = [
  'IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700',
  ...(locale === 'zh-Hant' ? ['Noto+Sans+TC:wght@400;500;600;700'] : []),
  ...(locale === 'ja' ? ['Noto+Sans+JP:wght@400;500;600;700'] : []),
  'PT+Sans:wght@400;700',
  'Inter:wght@400;500;600;700',
  'Red+Hat+Display:wght@400;500;700',
];
const fontsUrl = `https://fonts.googleapis.com/css2?${fontFamilies.map((f) => `family=${f}`).join('&')}&display=swap`;
---

<!doctype html>
<html lang={htmlLang} data-theme={theme === 'dark' ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    {alternateLocales.map(({ locale: loc, path }) => (
      <link rel="alternate" hreflang={localeToHtmlLang(loc)} href={urlFor(loc, path)} />
    ))}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}

    {/* OpenGraph (Webflow used "copy SEO title/description" — same here). */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    {/* Twitter (summary card — no image). */}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/webclip.png" />

    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {plausibleDomain && <link rel="preconnect" href="https://plausible.io" crossorigin />}
    {gtmId && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}
    <link href={fontsUrl} rel="stylesheet" />

    <link href="/css/webflow.css" rel="stylesheet" />
    <link href="/css/authgear-new.webflow.css" rel="stylesheet" />
    <link href="/css/authgear-ds-split-stack.css" rel="stylesheet" />

    <style is:inline>
      .w-container { max-width: 1271px; }
      @media (hover:none) and (pointer:coarse) {
        * { background-attachment: scroll !important; }
      }
    </style>

    {/* Google Tag Manager — deferred until analytics cookie consent is granted */}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window.dataLayer = window.dataLayer || [];
        window.__loadGtm = function () {
          if (window.__gtmLoaded) return;
          window.__gtmLoaded = true;
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
        };
      </script>
    )}

    {/* Plausible (loaded only if PUBLIC_PLAUSIBLE_DOMAIN is set) */}
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.tagged-events.js"></script>
    )}
    <script is:inline>
      window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments); };
    </script>

  </head>
  <body class="bg-neutral-200">
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <div role="banner" class:list={["header event", { "header--dark": theme === "dark" }]}>
      <SiteNav locale={locale} theme={theme} />
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer dark">
      <SiteFooter locale={locale} />
    </footer>

    {gtmId && <CookieConsentBanner locale={locale} />}
  </body>
</html>
