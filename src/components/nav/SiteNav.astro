---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import {
  productsDropdownColumns,
  solutionsDropdownLinks,
  solutionsSideImage,
  resourcesDropdownLinks,
  developersDropdownLinks,
  type NavLink,
} from '@/lib/navigation-data';
import Button from './Button.astro';
import { GITHUB_REPO, GITHUB_REPO_URL, getGithubStars, formatStars } from '@/lib/github-stars';
import NavDropdown from './NavDropdown.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SolutionsNavIcons from './SolutionsNavIcons.astro';
import ResourcesDevelopersNavIcons from './ResourcesDevelopersNavIcons.astro';

interface Props {
  locale: string;
  /** Colour scheme. Same markup either way; 'dark' only changes colours. */
  theme?: 'light' | 'dark';
}
const { locale, theme = 'light' } = Astro.props;
const dark = theme === 'dark';

function label(link: NavLink): string {
  return link.label[locale] ?? link.label['en'] ?? '';
}

function note(link: NavLink): string | null {
  if (!link.note) return null;
  return link.note[locale] ?? link.note['en'] ?? null;
}

function href(pathOrUrl: string): string {
  if (pathOrUrl.startsWith('http')) return pathOrUrl;
  return localizedPath(locale, pathOrUrl);
}

const stars = formatStars(await getGithubStars());
const sideHref = href(solutionsSideImage.path);
const sideAlt = solutionsSideImage.alt[locale] ?? solutionsSideImage.alt['en'] ?? '';
---

<div class:list={["container-header", { "nav--dark": dark }]}>
  <a href={localizedPath(locale, '/')} class="brand">
    <img src="/images/authgear-logo.svg" alt={t(locale, 'Navigation.logoAlt')} class="header-logo" />
  </a>

  <nav
    id="site-nav"
    role="navigation"
    class="nav-menu"
    data-site-nav-panel
  >
    {/* Products */}
    <NavDropdown title={t(locale, 'Navigation.products')} panelClass="nav-menu-dropdown-list-full-width">
      <div class="nav-full-width-wrapper">
        <div class="nav-full-width-inner">
          {productsDropdownColumns.map((col) => {
            if (col.type === 'stacked') {
              return (
                <div class="nav-menu-dropdown-column">
                  <div class="nav-full-width-vertical-block">
                    {col.sections.map((sec) => (
                      <div class="nav-menu-dropdown-column">
                        <div class="nav-menu-dropdown-subtitle">
                          {sec.subtitle[locale] ?? sec.subtitle['en']}
                        </div>
                        <div class="nav-menu-dropdown-column-links">
                          {sec.links.map((item) => (
                            <a href={href(item.path!)} class="nav-menu-dropdown-link">
                              <div>{label(item)}</div>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            }

            if (col.type === 'productColumn') {
              return (
                <div class="nav-menu-dropdown-column">
                  <div class="nav-menu-dropdown-column-links">
                    <div class="nav-menu-dropdown-subtitle product">
                      {col.subtitle[locale] ?? col.subtitle['en']}
                    </div>
                    {col.links.map((item) => {
                      const linkNote = note(item);
                      return (
                        <a href={href(item.path!)} class="nav-menu-dropdown-link products">
                          <div>
                            <span>{label(item)}</span>
                            {linkNote && (
                              <>
                                <br />
                                <span class="nav-menu-dropdown-link-note">{linkNote}</span>
                              </>
                            )}
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              );
            }

            // col.type === 'simple'
            return (
              <div class="nav-menu-dropdown-column">
                <div class="nav-menu-dropdown-column">
                  <div class="nav-menu-dropdown-subtitle">
                    {col.subtitle[locale] ?? col.subtitle['en']}
                  </div>
                  <div class="nav-menu-dropdown-column-links">
                    {col.links.map((item) => (
                      <a href={href(item.path!)} class="nav-menu-dropdown-link">
                        <div>{label(item)}</div>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </NavDropdown>

    {/* Solutions */}
    <NavDropdown title={t(locale, 'Navigation.solutions')} panelClass="nav-menu-dropdown-list">
      <div class="nav-menu-dropdown-column">
        <div class="nav-menu-dropdown-column-links">
          {solutionsDropdownLinks.map((item) => (
            <a href={href(item.path!)} class="nav-menu-dropdown-link">
              <div class="nav-dropdown-icon-embed">
                <SolutionsNavIcons name={item.path!} />
              </div>
              <div>{label(item)}</div>
            </a>
          ))}
        </div>
      </div>
      <div class="nav-menu-dropdown-column image">
        <a href={sideHref}>
          <img src={solutionsSideImage.src} loading="eager" width={solutionsSideImage.width} alt={sideAlt} />
        </a>
      </div>
    </NavDropdown>

    {/* Resources */}
    <NavDropdown title={t(locale, 'Navigation.resources')} panelClass="nav-menu-dropdown-list">
      <div class="nav-menu-dropdown-column no-gap">
        {resourcesDropdownLinks.map((item) => (
          <a href={href(item.path!)} class="nav-menu-dropdown-link">
            <div class="nav-dropdown-icon-embed">
              <ResourcesDevelopersNavIcons name={item.path!} />
            </div>
            <div>{label(item)}</div>
          </a>
        ))}
      </div>
    </NavDropdown>

    {/* Developers */}
    <NavDropdown title={t(locale, 'Navigation.developers')} panelClass="nav-menu-dropdown-list" panelModifier="developers">
      <div class="nav-menu-dropdown-column">
        <div class="nav-menu-dropdown-column-links">
          {developersDropdownLinks.map((item) => (
            <a href={item.href ?? href(item.path!)} class="nav-menu-dropdown-link">
              <div class="nav-dropdown-icon-embed">
                <ResourcesDevelopersNavIcons name={item.href ?? item.path ?? ''} />
              </div>
              <div>{label(item)}</div>
            </a>
          ))}
        </div>
      </div>
    </NavDropdown>

    <ul role="list" class="header-navigation">
      <li class="nav-item-wrapper">
        <a href={localizedPath(locale, '/pricing')} class="nav-link">
          {t(locale, 'Navigation.pricing')}
        </a>
      </li>
    </ul>

    <div class="mobile-nav-buttons">
      <Button
        href={localizedPath(locale, '/schedule-demo')}
        variant="primary"
        plausibleEvent="get-demo"
        plausibleLocation="nav-mobile"
        class="header-button-mobile get-demo"
      >
        {t(locale, 'Navigation.getDemo')}
      </Button>
    </div>

    {/* Login and the language switcher live in the top bar on desktop; at
        mobile that bar carries the news alone and these move down here. */}
    <div class="mobile-nav-utilities">
      <a
        href="https://portal.authgear.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-login plausible-event-name--login plausible-event-location--nav-drawer"
      >
        {t(locale, 'Navigation.login')}
      </a>
      <LanguageSwitcher locale={locale} variant="drawer" />
    </div>
  </nav>

  <div class="split-content header-right">
    <a
      href={GITHUB_REPO_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="nav-github-star plausible-event-name--github-star plausible-event-location--nav-header"
      aria-label={t(locale, 'Navigation.githubStarLabel')}
      data-github-stars={GITHUB_REPO}
    >
      <svg class="nav-github-star__icon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span class="nav-github-star__label">{t(locale, 'Navigation.githubStar')}</span>
      <span class="nav-github-star__count" data-github-star-count>{stars}</span>
    </a>
    <Button
      href="https://portal.authgear.com/"
      target="_blank"
      variant="primary"
      plausibleEvent="signup"
      plausibleLocation="nav-header"
      class="header-button"
    >
      {t(locale, 'Navigation.signup')}
    </Button>
    <Button
      href={localizedPath(locale, '/schedule-demo')}
      variant="ghost"
      plausibleEvent="get-demo"
      plausibleLocation="nav-desktop"
      class="login"
    >
      <div>{t(locale, 'Navigation.getDemo')}</div>
    </Button>
    <button
      type="button"
      class="site-nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t(locale, 'Navigation.menuToggleLabel')}
      data-site-nav-toggle
    >
      <span class="site-nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</div>

<style is:global>
  /* Mobile drawer: replaces Webflow's w-nav behavior. At >=992px the
     nav renders inline as today; at <=991px it collapses behind the
     hamburger and animates open on tap. `is:global` is needed because
     several selectors target descendants rendered by child components
     (Button, NavDropdown) which have their own scoping attributes. */
  /* Fresh hamburger button — no Webflow inheritance. Fixed 40×40
     hit target, icon lines sized within the button. `position: relative`
     confines the inner absolute wrapper (if any) to the button itself. */
  /* The Webflow export keyed the ghost nav-button styles to the old
     `.plausible-event-name--login` class (selector:
     `.nav-button.login.plausible-event-name--login`). Restated here so
     the ghost button keeps its look regardless of which Plausible event
     class it carries (e.g. `get-demo`). */
  .nav-button.login {
    flex: 0 auto;
    transition: transform 0.35s, color 0.35s;
    display: inline-flex;
  }
  .nav-button.login:hover {
    transform: scale(0.97);
  }

  /* The Webflow export shrinks the logo on hover (.brand:hover scales it
     down). It reads as a glitch rather than affordance, so the logo now
     holds still on every page. */
  .container-header .brand,
  .container-header .brand:hover {
    transform: none;
    transition: none;
  }

  /* Signup/Login, desktop and in the drawer: the plain primary style
     (tokens in global.css) in place of Webflow's diagonal gradient and its
     shrink-on-hover. */
  .button-primary.header-button,
  .button-primary.header-button-mobile {
    background-image: none;
    background-color: var(--btn-plain-bg);
    box-shadow: var(--btn-plain-shadow);
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .button-primary.header-button:hover,
  .button-primary.header-button-mobile:hover {
    background-color: var(--btn-plain-bg-hover);
    box-shadow: var(--btn-plain-shadow-hover);
    transform: translateY(-1px);
  }

  /* GitHub star pill: mark, "Star", divider, live count. Light by default,
     recoloured under .nav--dark. Hidden on phones, where the bar is full. */
  .nav-github-star {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    margin-right: 16px;
    border-radius: 14px;
    border: 1px solid #e4e8f0;
    background-color: #f5f7fb;
    color: #3e4f6f;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms ease, border-color 180ms ease;
  }
  .nav-github-star:hover {
    background-color: #eceff6;
    border-color: #d5dbe7;
    color: #3e4f6f;
  }
  .nav-github-star__icon {
    flex: 0 0 auto;
  }
  .nav-github-star__count {
    padding-left: 8px;
    border-left: 1px solid #d5dbe7;
    font-variant-numeric: tabular-nums;
  }
  .nav--dark .nav-github-star {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.9);
  }
  .nav--dark .nav-github-star:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
  }
  .nav--dark .nav-github-star__count {
    border-left-color: rgba(255, 255, 255, 0.18);
  }
  /* Small laptops (992 to 1199px): the bar has no room for the pill, the
     two CTAs, five menu items, and the logo at full size. Below 1200px the
     pill steps aside, the menu tightens, the logo holds a fixed width so it
     cannot be squeezed, and Get a Demo stays on one line. */
  @media (max-width: 1199px) {
    .nav-github-star {
      display: none;
    }
  }
  @media (min-width: 992px) and (max-width: 1199px) {
    .container-header > .nav-menu {
      grid-column-gap: 16px;
    }
    .container-header > .brand .header-logo {
      width: 140px;
      min-width: 140px;
    }
    .button-primary.header-button {
      margin-right: 12px;
      padding-left: 18px;
      padding-right: 18px;
    }
    .split-content.header-right .nav-button.login {
      white-space: nowrap;
    }
  }

  /* Drawer-only row: Login plus the language switcher, which sit in the top
     bar at desktop widths. Hidden above 991px, where the drawer never opens. */
  .mobile-nav-utilities {
    display: none;
  }

  .site-nav-toggle {
    display: none;
    position: relative;
    box-sizing: border-box;
    width: 40px;
    height: 40px;
    padding: 8px;
    margin: 0;
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    color: inherit;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
  }
  .site-nav-toggle:focus-visible {
    outline: 2px solid var(--primary-1, #0043e0);
    outline-offset: 2px;
  }
  .site-nav-toggle__bars {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 16px;
  }
  .site-nav-toggle__bars > span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #3e4f6f;
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-nav-toggle[aria-expanded='true'] .site-nav-toggle__bars > span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-nav-toggle[aria-expanded='true'] .site-nav-toggle__bars > span:nth-child(2) {
    opacity: 0;
  }
  .site-nav-toggle[aria-expanded='true'] .site-nav-toggle__bars > span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav-toggle__bars > span {
      transition: none;
    }
  }

  @media (max-width: 991px) {
    .site-nav-toggle {
      display: inline-flex;
    }
    /* Size the drawer's Get a Demo button like the signup button it
       replaced — the Webflow export keys those rules to the `.signup`
       class (`.button-primary.header-button-mobile.signup`), so they
       are restated here for the `.get-demo` modifier. */
    .button-primary.header-button-mobile.get-demo {
      flex: 1;
      align-self: stretch;
      padding-top: 10px;
      padding-bottom: 10px;
      font-size: 16px;
      font-weight: 400;
      line-height: 24px;
    }
    /* At mobile the .container-header switches to display: flex (from
       grid), so the grid-based justify-self: end in global.css no
       longer positions .header-right. Push it to the right edge with
       margin-left: auto, and right-align its flex content so the
       hamburger sits flush right. */
    .container-header > .split-content.header-right {
      margin-left: auto;
      justify-content: flex-end;
    }
    /* Keep the blue Signup/Login CTA visible on mobile (primary
       conversion action), hide only the Get a Demo ghost link — its
       mobile equivalent lives inside the drawer as .mobile-nav-buttons. */
    .split-content.header-right > a.nav-button {
      display: none;
    }
    .split-content.header-right {
      gap: 8px;
    }
    /* Override the Webflow-exported `.nav-menu` rules in
       authgear-new.webflow.css (~line 154 of the 991px block) that
       force a 100vw × 100vh overlay — those were designed to pair with
       webflow.js's overlay injection. We want a full-width dropdown
       panel below the header. Using position: fixed with left/right: 0
       so the panel escapes the container-header's horizontal padding
       and spans the full viewport. */
    .nav-menu[data-site-nav-panel] {
      display: none !important;
      position: fixed !important;
      top: var(--site-nav-top, 80px) !important;
      left: 0 !important;
      right: 0 !important;
      width: 100vw !important;
      height: auto !important;
      max-height: calc(100vh - var(--site-nav-top, 80px)) !important;
      overflow-y: auto !important;
      background: #ffffff !important;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
      padding: 1.25rem 1.5rem 2rem !important;
      z-index: 900;
      border: 0 !important;
    }
    .nav-menu[data-site-nav-panel][data-site-nav-open] {
      display: block !important;
    }

    .mobile-nav-utilities {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid #e4e8f0;
      /* Each collapsed section above is its own `z-index: 900` stacking
         context (.nav-menu-dropdown), so without this the language menu
         opens behind their chevrons. */
      position: relative;
      z-index: 901;
    }
    .mobile-nav-login {
      color: #3e4f6f;
      font-family: 'IBM Plex Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      line-height: 24px;
      text-decoration: none;
    }
    .ds-lang-switcher--drawer .ds-lang-switcher__btn {
      border-color: #e4e8f0;
      color: #3e4f6f;
      font-size: 16px;
    }
    /* Opens upward: the row sits at the bottom of a drawer that can already
       be scrolled to its end. */
    .ds-lang-switcher--drawer .ds-lang-switcher__dropdown {
      bottom: calc(100% + 0.5rem);
      right: 0;
      background: #fff;
      border: 1px solid #e4e8f0;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.14);
    }
    .ds-lang-switcher--drawer .ds-lang-switcher__option {
      color: #3e4f6f;
    }
    .ds-lang-switcher--drawer .ds-lang-switcher__option:hover {
      background-color: #f0f3f9;
      color: #0f172a;
      text-decoration: none;
    }
    .ds-lang-switcher--drawer .ds-lang-switcher__option--active {
      color: #0f172a;
      font-weight: 500;
    }
  }

  /* Dark colour scheme, opted into per page through BaseLayout's theme
     prop. One component, one set of markup: these rules only recolour the
     bar, its dropdown panels, and, below 991px, the drawer. The background
     matches the footer (.footer.dark, #000). */
  .header.header--dark {
    background-color: #0e0f28;
  }
  /* No divider under the dark bar; transparent rather than 0 so the bar's
     height, which the drawer offset is measured from, does not change. */
  .container-header.nav--dark {
    border-bottom-color: transparent;
  }
  .nav--dark .site-nav-toggle__bars > span {
    background-color: #fff;
  }
  /* Same logo file as the light bar, recoloured to white. The separate
     white logo asset is cropped differently and sat lower than the nav
     text, so reusing this one keeps the baseline where it is. */
  .nav--dark .header-logo {
    filter: brightness(0) invert(1);
  }
  .nav--dark .dropdown-toggle,
  .nav--dark .nav-link,
  .nav--dark .header-navigation,
  .nav--dark .nav-button.login {
    color: rgba(255, 255, 255, 0.86);
  }
  .nav--dark .dropdown-toggle:hover,
  .nav--dark .dropdown-toggle[aria-expanded='true'],
  .nav--dark .nav-link:hover,
  .nav--dark .nav-button.login:hover {
    color: #fff;
  }
  /* Dropdown panels and everything inside them, at every width. */
  /* Menus sit a shade above the navy bar: between the bar's #0e0f28 and the
     #1c1d3c of the dark cards. */
  .nav--dark .nav-menu-dropdown-list,
  .nav--dark .nav-menu-dropdown-list-full-width {
    background-color: #151633;
    color: rgba(255, 255, 255, 0.86);
  }
  .nav--dark .nav-menu-dropdown-link {
    color: rgba(255, 255, 255, 0.86);
  }
  .nav--dark .nav-menu-dropdown-link:hover {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.08);
  }
  .nav--dark .nav-menu-dropdown-link-note,
  .nav--dark .nav-menu-dropdown-subtitle {
    color: rgba(255, 255, 255, 0.55);
  }
  .nav--dark .nav-menu-dropdown-column.nav-column-line,
  .nav--dark .nav-menu-dropdown-column.image {
    border-color: rgba(255, 255, 255, 0.1);
  }
  @media (min-width: 992px) {
    /* Desktop panels float below the bar: a faint edge and a deep shadow
       separate them from whatever the page shows behind them. */
    .nav--dark .nav-menu-dropdown-list.w--open,
    .nav--dark .nav-menu-dropdown-list-full-width.w--open {
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.55);
    }
  }
  @media (max-width: 991px) {
    /* The drawer itself; the section panels unfolding inside it share its
       black, so only the dividers need attention. */
    .nav--dark .nav-menu[data-site-nav-panel] {
      background: #151633 !important;
      color: rgba(255, 255, 255, 0.86);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
      border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    .nav--dark .dropdown-toggle,
    .nav--dark .nav-item-wrapper {
      border-bottom-color: rgba(255, 255, 255, 0.1);
    }
    .nav--dark .mobile-nav-utilities {
      border-top-color: rgba(255, 255, 255, 0.1);
    }
    .nav--dark .mobile-nav-login,
    .nav--dark .ds-lang-switcher--drawer .ds-lang-switcher__btn {
      color: rgba(255, 255, 255, 0.86);
    }
    .nav--dark .ds-lang-switcher--drawer .ds-lang-switcher__btn {
      border-color: rgba(255, 255, 255, 0.2);
    }
    .nav--dark .ds-lang-switcher--drawer .ds-lang-switcher__dropdown {
      background: #1a1a2e;
      border-color: rgba(255, 255, 255, 0.15);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
    }
    .nav--dark .ds-lang-switcher--drawer .ds-lang-switcher__option {
      color: rgba(255, 255, 255, 0.72);
    }
    .nav--dark .ds-lang-switcher--drawer .ds-lang-switcher__option:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: #fff;
    }
    .nav--dark .ds-lang-switcher--drawer .ds-lang-switcher__option--active {
      color: #fff;
    }
  }
</style>

<script>
  // Refresh the GitHub star count after load. The build-time number is
  // already in the markup; this keeps it current between deploys. Cached in
  // localStorage for six hours so repeat visits make no request at all.
  (() => {
    const el = document.querySelector<HTMLElement>('[data-github-stars]');
    const out = el?.querySelector<HTMLElement>('[data-github-star-count]');
    if (!el || !out) return;
    const repo = el.dataset.githubStars!;
    const key = `gh-stars:${repo}`;
    const TTL = 6 * 60 * 60 * 1000;
    const format = (n: number) => {
      if (n < 1000) return String(n);
      const k = n / 1000;
      return (k >= 10 ? Math.round(k).toString() : k.toFixed(1).replace(/\.0$/, '')) + 'k';
    };
    try {
      const cached = JSON.parse(localStorage.getItem(key) ?? 'null') as { n: number; t: number } | null;
      if (cached && Date.now() - cached.t < TTL) {
        out.textContent = format(cached.n);
        return;
      }
    } catch {}
    fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d: { stargazers_count?: number } | null) => {
        if (typeof d?.stargazers_count !== 'number') return;
        out.textContent = format(d.stargazers_count);
        try { localStorage.setItem(key, JSON.stringify({ n: d.stargazers_count, t: Date.now() })); } catch {}
      })
      .catch(() => {});
  })();

  const BREAKPOINT = window.matchMedia('(max-width: 991px)');
  const toggle = document.querySelector<HTMLButtonElement>(
    '[data-site-nav-toggle]',
  );
  const panel = document.querySelector<HTMLElement>(
    '[data-site-nav-panel]',
  );

  if (toggle && panel) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const focusableSelectors = [
      'a[href]',
      'button:not([disabled])',
      'input:not([disabled])',
      'select:not([disabled])',
      'textarea:not([disabled])',
      '[tabindex]:not([tabindex="-1"])',
    ].join(',');

    function setOpen(open: boolean) {
      toggle!.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        // Pin the panel directly under the header, whatever its current
        // height. The fixed-position panel reads --site-nav-top.
        const header = toggle!.closest('[role="banner"]') as HTMLElement | null;
        const headerHeight = header?.getBoundingClientRect().height ?? 80;
        document.documentElement.style.setProperty(
          '--site-nav-top',
          `${Math.round(headerHeight)}px`,
        );
        panel!.setAttribute('data-site-nav-open', '');
        document.documentElement.style.overflow = 'hidden';
        const first = panel!.querySelector<HTMLElement>(focusableSelectors);
        first?.focus();
      } else {
        panel!.removeAttribute('data-site-nav-open');
        document.documentElement.style.overflow = '';
      }
    }

    function close() {
      setOpen(false);
      toggle!.focus();
    }

    toggle.addEventListener('click', (event) => {
      event.preventDefault();
      setOpen(!isOpen());
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      }
    });

    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      const target = event.target as Node | null;
      if (!target) return;
      if (panel!.contains(target) || toggle!.contains(target)) return;
      setOpen(false);
    });

    panel.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('a')) setOpen(false);
    });

    panel.addEventListener('keydown', (event) => {
      if (!isOpen() || event.key !== 'Tab') return;
      const focusables = Array.from(
        panel!.querySelectorAll<HTMLElement>(focusableSelectors),
      ).filter((el) => el.offsetParent !== null);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    BREAKPOINT.addEventListener('change', () => {
      if (!BREAKPOINT.matches && isOpen()) setOpen(false);
    });
  }
</script>
