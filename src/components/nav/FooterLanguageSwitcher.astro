---
import { localeAlternates, localeUrlSegment, stripLocaleSegment } from '@/lib/i18n';

interface Props {
  locale: string;
  currentPath?: string;
}

const { locale, currentPath = Astro.url.pathname } = Astro.props;

const LOCALE_LABELS: Record<string, string> = {
  en: 'English',
  'zh-Hant': '中文',
  ja: '日本語',
  es: 'Español',
  de: 'Deutsch',
  fr: 'Français',
};

const basePath = stripLocaleSegment(currentPath);

// Locales offered as switch-TO targets. Home-only locales (ja, es, de) appear
// on the home page, where their translation exists, and nowhere else, so the
// switcher never sends anyone to a URL that would redirect back to English.
// Each target brings its own path, since a market-specific page carries a
// different slug per locale.
const SWITCHABLE_LOCALES = localeAlternates(basePath);
const currentLabel = LOCALE_LABELS[locale] ?? 'Language';
---

<div class="ds-footer-lang-switcher" id="footer-lang-switcher">
  <button
    type="button"
    class="ds-footer-lang-switcher__btn"
    aria-expanded="false"
    aria-haspopup="listbox"
    id="footer-lang-btn"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="ds-footer-lang-switcher__icon"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
    </svg>
    <span>{currentLabel}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="ds-footer-lang-switcher__chevron"
      id="footer-lang-chevron"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>
  <ul class="ds-footer-lang-switcher__dropdown" role="listbox" id="footer-lang-dropdown" hidden>
    {SWITCHABLE_LOCALES.map(({ locale: l, path }) => (
      <li role="option" aria-selected={l === locale}>
        <a
          href={`${localeUrlSegment(l)}${path}`}
          class={`ds-footer-lang-switcher__option${l === locale ? ' ds-footer-lang-switcher__option--active' : ''}`}
        >
          {LOCALE_LABELS[l]}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  (function () {
    const wrapper = document.getElementById('footer-lang-switcher');
    const btn = document.getElementById('footer-lang-btn');
    const dropdown = document.getElementById('footer-lang-dropdown');
    const chevron = document.getElementById('footer-lang-chevron');

    if (!wrapper || !btn || !dropdown || !chevron) return;

    const open = () => {
      dropdown.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      chevron.classList.add('ds-footer-lang-switcher__chevron--open');
    };

    const close = () => {
      dropdown.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      chevron.classList.remove('ds-footer-lang-switcher__chevron--open');
    };

    btn.addEventListener('click', function () {
      if (dropdown.hidden) {
        open();
      } else {
        close();
      }
    });

    document.addEventListener('mousedown', function (e) {
      if (!wrapper.contains(e.target as Node)) {
        close();
      }
    });
  })();
</script>
