---
import { localizedPath } from '@/lib/i18n';
import { footerStrings } from '@/lib/navigation-data';
import { localizedString } from '@/lib/site-navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

function lp(path: string): string {
  return localizedPath(locale, path);
}

function L(key: string): string {
  return localizedString(footerStrings, key, locale);
}

const powered = L('poweredBy');
const poweredSuffix = L('poweredBySuffix');
