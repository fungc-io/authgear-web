---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import ContactForm from '@/components/islands/ContactForm';
import LogoMarquee from '@/components/islands/LogoMarquee';
import HomeHeroKv from '@/components/pages/home/HomeHeroKv.astro';

interface Props { locale: string }
const { locale } = Astro.props;

function tRich(locale: string, key: string, gradientExtraClass = ''): string {
  const raw = t(locale, key);
  const gradientClass = gradientExtraClass
    ? `once-gradient ${gradientExtraClass}`
    : 'once-gradient';
  return raw
    .replace(/<gradient>([\s\S]*?)<\/gradient>/g, `<span class="${gradientClass}">$1</span>`)
    .replace(/<br><\/br>/g, '<br>')
    .replace(/<br\s*\/>/g, '<br>');
}
