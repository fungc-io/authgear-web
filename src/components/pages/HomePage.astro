<style>
  /* Hero description + CTA row. These used to ride on Webflow's
     `.paragraph-large.home-hero` / `.home-hero-cta-wrapper` / `.button-primary`
     stack, whose breakpoint rules centred the copy between 768px and 991px and
     stacked the CTAs into a column (with a full-width button that never
     materialised) below 768px. Styled here directly instead: left-aligned at
     every width, button and docs link side by side, wrapping only when the row
     genuinely runs out of room. The button is the design-system primary. */
  .home-hero__desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    text-align: left;
  }
  .home-hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.5rem;
  }
  .home-hero__docs {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease;
  }
  .home-hero__docs:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .hero-trust-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-trust-strip li {
    position: relative;
    color: #afb7ff;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .hero-trust-strip li + li::before {
    content: '';
    position: absolute;
    left: -0.68rem;
    top: 50%;
    width: 3px;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }
  @media (max-width: 767px) {
    .hero-trust-strip { justify-content: center; }
  }
  /* The separator is an absolutely-positioned dot to the left of each item, so
     once the strip wraps it leads the new line ("· Self-hostable"). Below 480px
     the strip always wraps; drop the dots there and let the gap do the work. */
  @media (max-width: 479px) {
    .hero-trust-strip {
      column-gap: 1rem;
    }
    .hero-trust-strip li + li::before {
      content: none;
    }
  }

  /* "Security shouldn't slow you down" — top row of 3 cards.
     The three source SVGs have different intrinsic aspect ratios, so at
     width:auto/height:100% the middle one rendered 22px taller than its
     neighbours. Pin all three to one ratio (object-fit keeps them undistorted)
     and stack from the top, so the headings share a baseline regardless of how
     many lines each description runs to. */
  .home-feature-cards-v2_image.width-auto.px-30.height-100.bf-align-img {
    width: 100%;
    height: auto;
    aspect-ratio: 378 / 343;
    object-fit: contain;
  }
  /* The stock rule for these cards is display:flex with the default row
     direction plus align-items:center, which centres the single content block
     VERTICALLY — so a card with fewer lines of copy starts lower than its
     neighbour. Top-align instead, so icons and titles share a baseline. */
  .home-card.radius-48.bg-diagonal-gradient-dark.content-center {
    align-items: flex-start;
  }

  /* "One identity across every app you run" sits on a dark band instead of
     the page background. The band starts and ends on the navy of the section
     above it, so the seam is invisible, with a violet glow behind the heading
     and a cooler blue glow low on the right. The cards drop Webflow's
     saturated gradient, which would fight the band, for dark glass with a
     faint diagonal tint in the same hue and direction as the original. */
  .home-identity {
    background-color: #0e0f28;
    background-image:
      radial-gradient(ellipse 56% 29% at 50% 30%, rgba(85, 36, 243, 0.42), transparent 100%),
      radial-gradient(ellipse 640px 480px at 88% calc(100% - 92px), rgba(11, 99, 233, 0.24), transparent 100%),
      linear-gradient(180deg, #0e0f28 0%, #13153f 50%, #0e0f28 100%);
  }
  /* The same glass treatment is shared by the three solution cards under
     "Secure Every User Journey", replacing their flat #1c1d3c and Webflow's
     saturated gradient hover. Those cards are links, so the hover also has to
     restate background-image, which the Webflow hover rule sets. */
  .home-identity .home-card.radius-48.bg-diagonal-gradient-dark,
  .home-card.radius-48.bg-1c1d3c.with-button {
    background-color: rgba(255, 255, 255, 0.04);
    background-image: linear-gradient(304deg, rgba(157, 161, 255, 0.16), rgba(95, 101, 235, 0.06) 40%, rgba(0, 9, 103, 0.28));
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 30px 60px -40px rgba(0, 4, 42, 0.9);
    transition: background-color .2s, border-color .2s, box-shadow .2s;
  }
  .home-identity .home-card.radius-48.bg-diagonal-gradient-dark:hover,
  .home-card.radius-48.bg-1c1d3c.with-button:hover {
    background-color: rgba(255, 255, 255, 0.07);
    background-image: linear-gradient(304deg, rgba(157, 161, 255, 0.16), rgba(95, 101, 235, 0.06) 40%, rgba(0, 9, 103, 0.28));
    border-color: rgba(174, 182, 228, 0.4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 30px 60px -36px rgba(0, 4, 42, 1);
  }

  /* Inline doc links inside card copy. set:html markup gets no Astro scoping
     attribute, so these need :global(). */
  .home-card-description-text :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    font-weight: 500;
    transition: opacity .15s;
  }
  .home-card-description-text :global(a:hover) { opacity: 0.75; }
  /* Dark cards: the link keeps the paragraph's colour and weight, so the
     underline alone marks it. */
  .home-card-description-text.text-cee9ff :global(a) { color: inherit; font-weight: inherit; }
  /* "Build a Zero-Trust Foundation" continues the identity band above it. The
     band's low-right blue glow is drawn in px and centred 92px above its bottom
     edge; the same glow is drawn here with the same radii, centred 92px above
     this section's top edge, so the two halves meet at the seam as one shape.
     A softer violet wash sits behind the columns, and the section fades back to
     flat navy before the footer form. Its columns are transparent, so Webflow's
     blue hover flash on .home-card is switched off here. */
  .home-zero-trust {
    background-color: #0e0f28;
    background-image:
      radial-gradient(ellipse 640px 480px at 88% -92px, rgba(11, 99, 233, 0.24), transparent 100%),
      radial-gradient(ellipse 56% 34% at 50% 48%, rgba(85, 36, 243, 0.2), transparent 100%),
      linear-gradient(180deg, #0e0f28 0%, #111335 55%, #0e0f28 100%);
  }
  .home-zero-trust .home-card.transparent:hover {
    background-color: transparent;
    box-shadow: none;
  }

  /* "One identity across every app you run" is now four cards, not three.
     The first card was a Webflow 2-row hero tile (span 2 / span 6); drop it to
     one row and give the new AI-agents card the same 6-of-12 span so the
     section reads as an even 2x2. ID selectors beat classes, so the override
     has to target the same w-node id. */
  #w-node-d65fc3a0-b6c2-ca3b-1f39-c1cfdab29cd1-19df57f8 {
    grid-area: span 1 / span 6 / span 1 / span 6;
  }
  .mc-agents {
    grid-area: span 1 / span 6 / span 1 / span 6;
  }

  /* Customer-story cards now sit on a light band. The stock Webflow rule
     fades them to transparent (#5524f3 -> #4b4fa200), which on white washed
     out the lower half of each card and left white body text on near-white.
     End the gradient on the same solid navy the no-logo card already uses, so
     every card is self-contained and the anonymous card stops being the only
     dark one in the grid. Only used on this page (.container-1470 appears
     nowhere else), so this is safe to override here. */
  .container-1470,
  .container-1470.no-logo {
    background-image: radial-gradient(circle at -10% -10%, #5524f3, #1c1d3c);
    border-color: #4a4c7a;
  }

  /* Card body copy: a bold one-line hook on its own line, then short
     supporting text — so the row can be skimmed by hook alone. */
  /* :global() is required — Astro's scoped attribute is not applied to
     markup injected through set:html, so a plain descendant selector
     would never match these <strong> elements. */
  .bf-desc :global(strong) {
    display: block;
    margin-bottom: 0.4em;
    color: #fff;
    font-weight: 600;
  }
  /* Bottom row of 2 — same treatment, that row's own ratio. */
  .home-feature-cards-v2_image.width-auto.px-30.height-100.bf-align-img-wide {
    width: 100%;
    height: auto;
    aspect-ratio: 480 / 260;
    object-fit: contain;
  }
  .home-feature-cards-v2_card.dark.center.bf-align-card {
    justify-content: flex-start;
  }
  /* Below 991px Webflow's grid hands the hooks card the full 12-column row and
     pins the two bottom-row cards to grid row 2, so the cards ran 1,2 / 4,5 / 3
     and the hooks graphic scaled to the card's full width (930px wide, 845px
     tall at a 979px viewport). Reflow to 1,2 / 3,4 with "Design your flows"
     as the closing full-row card, and cap every graphic at 480px so a wide
     card stays compact. Below 767px the wrap becomes a flex column, so DOM
     order applies and the flow card closes the list there as well. ID
     selectors are required to beat Webflow's own. */
  @media (max-width: 991px) {
    #w-node-d65fc3a0-b6c2-ca3b-1f39-c1cfdab29d32-19df57f8,
    #w-node-d65fc3a0-b6c2-ca3b-1f39-c1cfdab29d3a-19df57f8 {
      grid-area: auto / span 6 / auto / span 6;
    }
    #w-node-d65fc3a0-b6c2-ca3b-1f39-c1cfdab29d42-19df57f8 {
      grid-area: auto / span 12 / auto / span 12;
    }
    .home-feature-cards-v2_image.width-auto.px-30.height-100.bf-align-img,
    .home-feature-cards-v2_image.width-auto.px-30.height-100.bf-align-img-wide {
      max-width: 480px;
      align-self: center;
    }
    /* The hooks graphic is landscape (420x260). Its near-square desktop box
       only exists to align the top row's headings; here it shares a row with
       the SDK card, so take that card's box ratio instead. */
    .home-feature-cards-v2_image.width-auto.px-30.height-100.bf-align-img.bf-align-img-landscape {
      aspect-ratio: 480 / 260;
    }
    /* Keep the full-row card's copy at a readable measure. */
    #w-node-d65fc3a0-b6c2-ca3b-1f39-c1cfdab29d42-19df57f8 .home-feature-cards-v2_info-wrap {
      max-width: 640px;
      margin-inline: auto;
    }
  }

  /* Hero alignment: the header and every other section sit in a 1271px
     container with 24px side padding, but the hero used a 1440px container
     plus 60px of inner padding, so its left edge never lined up with the
     logo. On desktop the hero now uses the same container geometry, with the
     inner padding removed, so text starts under the logo and the artwork
     ends under the Get a Demo link. */
  @media (min-width: 992px) {
    .container-1440.home-mobile-banner {
      max-width: 1271px;
    }
    .home-hero-wrapper {
      padding-left: 0;
    }
  }

  /* Hero buttons: the plain primary style (tokens in global.css) for Start
     Free and the active product-switch tab. */
  .home-hero__cta .ds-btn-primary,
  .flex-block-66.active {
    background-image: none;
    background-color: var(--btn-plain-bg);
    box-shadow: var(--btn-plain-shadow);
  }
  .home-hero__cta .ds-btn-primary {
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .home-hero__cta .ds-btn-primary:hover {
    background-color: var(--btn-plain-bg-hover);
    box-shadow: var(--btn-plain-shadow-hover);
    transform: translateY(-1px);
  }

  /* Footer form: the supporting line under the heading is body copy, not a
     second heading, so it drops Webflow's bold weight. */
  .footer-get-started-text {
    font-weight: 400;
  }

  /* Card titles inherit the global h3 leading of 1.063em, which is a display
     ratio tuned for the 32px heading size. These titles render at 22px and
     eight of the nine wrap to two lines on a phone, where 1.063 leaves the
     lines almost touching. */
  .home-feature-cards-v2_info-heading {
    line-height: 1.25;
  }
</style>
