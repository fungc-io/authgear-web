---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import FaqList from '@/components/FaqList.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const tFeatures = (key: string) => t(locale, `Features.${key}`);
const tK = (key: string) => t(locale, `KeycloakAlternative.${key}`);

const PORTAL_SIGNUP_URL =
  'https://portal.authgear.com/?utm_source=compare-keycloak&utm_medium=link&utm_campaign=start-for-free';
const CHECK = '/images/compare_table-check-blue.svg';
const CHECK_COMPETITOR = '/images/compare_table-check-gray.svg';
const CROSS = '/images/compare_table-false.svg';

const faqItems = [1, 2, 3, 4, 5, 6, 7].map((i) => ({ q: tK(`faq${i}Q`), a: tK(`faq${i}A`) }));
---

<>
  <div class="featurespage__hero_v2 featurespage__hero_bg vs-page">
    <div class="features-hero-wrapper-new gap140">
      <div class="split-content features-hero-left vs-mobile">
        <h1 class="title features-hero-v2 vs-mobile">{tK('heroTitle')}</h1>
        <p class="features-hero-description">{tK('heroDescription')}</p>
        <div class="features-hero-cta-wrapper vs-mobile">
          <a
            href={PORTAL_SIGNUP_URL}
            target="_blank"
            rel="noreferrer"
            class="button-primary feature-hero-btn-v2 vs-mobile w-button plausible-event-name--signup plausible-event-location--keycloak-alternative-hero"
          >
            {tFeatures('startForFree')}
          </a>
          <a
            href={localizedPath(locale, '/schedule-demo')}
            target="_blank"
            class="button-secondary feature-hero-btn-v2 noscale button-secondary-with-boarder w-button plausible-event-name--get-demo plausible-event-location--keycloak-alternative-hero"
          >
            {tFeatures('scheduleDemo')}
          </a>
        </div>
      </div>
      <img
        src="/images/data-sovereignty_hero.svg"
        width="640"
        height="520"
        alt=""
        class="image features-hero-image-v2 _300max"
      />
    </div>
  </div>

  <div>
    <div class="container-default wider-container-default logo-section">
      <div class="container-default-inner px-0 gap-0 pb-0"></div>
      <img src="/images/compare_logo-Bupa-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-CIMIC-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-HML-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo_hkpc_gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-k11-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-MTR-gray2x.png" loading="lazy" alt="" class="image-86" />
    </div>
  </div>

  {/* The comparison table sits straight after the logo strip: most visitors arrive
      from "keycloak alternatives" searches and want the side-by-side first. */}
  <div>
    <div class="container-default wider-container-default">
      <div class="container-default-inner px-0 gap-0 pb-0">
        <div class="top-content feature-flex">
          <h2 class="title features-page-v2">{tK('compareTitle')}</h2>
        </div>
        <div class="div-block-25" data-compare-table>
          <div class="w-layout-grid table-header">
            <div class="w-layout-blockcontainer w-container"></div>
            <img src="/images/compare_table-Authgear.svg" loading="lazy" alt="Authgear" />
            <div class="okta">{tK('competitorName')}</div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="licence">
            <div class="table-text title">{tK('tableLicenceTitle')}</div>
            <div class="table-text">{tK('tableLicenceAuthgear')}</div>
            <div class="table-text">{tK('tableLicenceCompetitor')}</div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="self-host">
            <div class="table-text title">{tK('tableSelfHostTitle')}</div>
            <div class="table-text">{tK('tableSelfHostAuthgear')}</div>
            <div class="table-text">{tK('tableSelfHostCompetitor')}</div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="cloud">
            <div class="table-text title">{tK('tableCloudTitle')}</div>
            <div class="table-text">{tK('tableCloudAuthgear')}</div>
            <div class="table-text">{tK('tableCloudCompetitor')}</div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="branding">
            <div class="table-text title">{tK('tableBrandingTitle')}</div>
            <div class="table-text">{tK('tableBrandingAuthgear')}</div>
            <div class="table-text">{tK('tableBrandingCompetitor')}</div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="passkeys">
            <div class="table-text title">{tK('tablePasskeysTitle')}</div>
            <img src={CHECK} loading="lazy" alt="Yes" />
            <img src={CHECK_COMPETITOR} loading="lazy" alt="Yes" />
          </div>

          <div class="w-layout-grid table-header table-content" data-row="magic-link">
            <div class="table-text title">{tK('tableMagicLinkTitle')}</div>
            <img src={CHECK} loading="lazy" alt="Yes" />
            <div class="compare-table-multi-info">
              <img src={CROSS} loading="lazy" alt="No" />
              <div class="compare-table-text-light title">{tK('tableViaExtensions')}</div>
            </div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="sms-whatsapp">
            <div class="table-text title">{tK('tableSmsWhatsappTitle')}</div>
            <img src={CHECK} loading="lazy" alt="Yes" />
            <div class="compare-table-multi-info">
              <img src={CROSS} loading="lazy" alt="No" />
              <div class="compare-table-text-light title">{tK('tableViaExtensions')}</div>
            </div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="mobile-biometric">
            <div class="table-text title">{tK('tableMobileBiometricTitle')}</div>
            <div class="table-text">{tK('tableMobileBiometricAuthgear')}</div>
            <div class="table-text">{tK('tableMobileBiometricCompetitor')}</div>
          </div>

          <div class="w-layout-grid table-header table-content" data-row="ldap">
            <div class="table-text title">{tK('tableLdapTitle')}</div>
            <img src={CHECK} loading="lazy" alt="Yes" />
            <img src={CHECK_COMPETITOR} loading="lazy" alt="Yes" />
          </div>

          <div class="w-layout-grid table-header table-content last-row" data-row="support">
            <div class="table-text title">{tK('tableSupportTitle')}</div>
            <div class="table-text">{tK('tableSupportAuthgear')}</div>
            <div class="table-text">{tK('tableSupportCompetitor')}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div>
    <div class="container-default wider-container-default">
      <div class="container-default-inner px-0 gap-0 pb-0">
        <div class="top-content feature-flex">
          <h2 class="title features-page-v2">{tK('whyChooseTitle')}</h2>
        </div>
      </div>
      <div class="w-layout-hflex flex-block-71">
        {[
          { icon: '/images/compare_why-agnostic.svg', n: 1 },
          { icon: '/images/compare_why-custom.svg', n: 2 },
          { icon: '/images/compare_why-success.svg', n: 3 },
        ].map(({ icon, n }) => (
          <div class="svg-card gray-card">
            <div class="svg-card-image-container">
              <img src={icon} loading="lazy" alt="" />
            </div>
            <div class="svg-card-content-container text-center gap-16">
              <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">{tK(`card${n}Title`)}</div>
              <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                {tK(`card${n}Description`)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-f9f9fb">
    <div class="container-default">
      <div class="container-default-inner px-0 gap-0">
        <div class="_3-card-grid">
          {[
            { icon: '/images/compare_features-flow.svg', n: 1 },
            { icon: '/images/compare_features-authentication.svg', n: 2 },
            { icon: '/images/compare_features-developer.svg', n: 3 },
          ].map(({ icon, n }) => (
            <div class="svg-card">
              <div class="svg-card-image-container">
                <img src={icon} loading="lazy" width="48" alt="" />
              </div>
              <div class="svg-card-content-container text-center gap-16">
                <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">{tK(`feature${n}Title`)}</div>
                <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                  {tK(`feature${n}Description`)}
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="_2-card-grid gap-32 mb-40 _2-rows">
          {[
            { icon: '/images/compare_features-account.svg', n: 4 },
            { icon: '/images/compare_features-support.svg', n: 5 },
          ].map(({ icon, n }) => (
            <div class="svg-card">
              <div class="svg-card-image-container">
                <img src={icon} loading="lazy" width="48" alt="" />
              </div>
              <div class="svg-card-content-container text-center gap-16">
                <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">{tK(`feature${n}Title`)}</div>
                <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                  {tK(`feature${n}Description`)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  {/* Light band between the grey feature grid and the dark migration band, so two
      successive sections never share the same treatment. */}
  <section class="ds-section ds-bg-light-blue" data-sovereignty-block>
    <div class="ds-container">
      <div class="title-content">
        <h2 class="heading-on-light">{tK('sovereigntyTitle')}</h2>
        <p class="section-lede-on-light">{tK('sovereigntyDescription')}</p>
      </div>
      <div class="ds-footer-cta__actions">
        <a href={localizedPath(locale, '/solutions/data-sovereignty')} class="ds-btn ds-btn-primary">
          {tK('sovereigntyLink')}
        </a>
      </div>
    </div>
  </section>

  <div>
    <div class="container-default wider-container-default">
      <div class="container-default-inner px-0 gap-0 pb-0"></div>
      <div class="w-layout-hflex ready-to-switch">
        <h2 class="title features-hero-v2 inverse nomargin">{tK('ctaMigrateTitle')}</h2>
        <div class="split-content features-hero-left nomargin">
          <p class="features-hero-description inverse">{tK('ctaMigrateDescription')}</p>
          <div class="features-hero-cta-wrapper in-ready-to-switch">
            <a
              href={localizedPath(locale, '/schedule-demo')}
              target="_blank"
              class="button-primary feature-hero-btn-v2 nomargin w-button plausible-event-name--get-demo plausible-event-location--keycloak-alternative-migrate"
            >
              {tFeatures('scheduleDemo')}
            </a>
            <a
              href={PORTAL_SIGNUP_URL}
              target="_blank"
              rel="noreferrer"
              class="button-secondary feature-hero-btn-v2 noscale button-secondary-with-boarder inverse w-button plausible-event-name--signup plausible-event-location--keycloak-alternative-migrate"
            >
              {tFeatures('startForFree')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <FaqList heading={tK('faqTitle')} items={faqItems} />
</>
