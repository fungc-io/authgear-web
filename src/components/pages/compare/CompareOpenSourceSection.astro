---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tCompare = (key: string) => t(locale, `Compare.${key}`);

const cards = [
  {
    key: 'openSourceCard1',
    href: 'https://github.com/authgear/authgear-server',
    external: true,
    icon: 'code',
  },
  {
    key: 'openSourceCard2',
    href: localizedPath(locale, '/post/self-hosted-authentication-docker-kubernetes'),
    external: false,
    icon: 'server',
  },
  {
    key: 'openSourceCard3',
    href: localizedPath(locale, '/solutions/data-sovereignty'),
    external: false,
    icon: 'globe',
  },
] as const;
---

<div class="bg-f9f9fb">
  <div class="container-default wider-container-default">
    <div class="container-default-inner px-0 gap-0 pb-0">
      <div class="top-content feature-flex">
        <h2 class="title features-page-v2">{tCompare('openSourceTitle')}</h2>
      </div>
    </div>
    <div class="w-layout-hflex flex-block-71 compare-open-source">
      {
        cards.map((card) => (
          <div class="svg-card">
            <div class="svg-card-image-container">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                {card.icon === 'code' && (
                  <path
                    d="M17 14 7 24l10 10M31 14l10 10-10 10M27 10l-6 28"
                    stroke="#0043E0"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                )}
                {card.icon === 'server' && (
                  <>
                    <rect x="8" y="9" width="32" height="12" rx="3" stroke="#0043E0" stroke-width="3" />
                    <rect x="8" y="27" width="32" height="12" rx="3" stroke="#0043E0" stroke-width="3" />
                    <path d="M15 15h.01M15 33h.01" stroke="#0043E0" stroke-width="4" stroke-linecap="round" />
                  </>
                )}
                {card.icon === 'globe' && (
                  <>
                    <circle cx="24" cy="24" r="16" stroke="#0043E0" stroke-width="3" />
                    <path
                      d="M8 24h32M24 8c4.5 4.5 6.5 10 6.5 16S28.5 35.5 24 40c-4.5-4.5-6.5-10-6.5-16S19.5 12.5 24 8Z"
                      stroke="#0043E0"
                      stroke-width="3"
                      stroke-linejoin="round"
                    />
                  </>
                )}
              </svg>
            </div>
            <div class="svg-card-content-container text-center gap-16">
              <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
                {tCompare(`${card.key}Title`)}
              </div>
              <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                {tCompare(`${card.key}Description`)}
              </div>
              <a
                class="compare-open-source__link"
                href={card.href}
                {...(card.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {tCompare(`${card.key}Link`)} →
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .compare-open-source {
    padding-bottom: 4rem;
  }

  .compare-open-source__link {
    align-self: flex-start;
    color: #0043e0;
    font-weight: 600;
    text-decoration: none;
  }

  .compare-open-source__link:hover {
    text-decoration: underline;
  }
</style>
