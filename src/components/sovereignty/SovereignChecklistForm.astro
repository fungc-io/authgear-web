---
// The sovereign login checklist download form: a Netlify form (registered in
// public/__forms.html as `sovereign-login-checklist`), a client-side POST,
// then the PDF in a new tab. Shared by /sovereign-login-checklist/ and
// /sovereignty-self-check/; `source` tells the submissions apart and
// `location` tags the Plausible events.
import { localizedPath } from '@/lib/i18n';

interface Props {
  /** Sent as the `source` form field. */
  source: string;
  /** `location` prop for the `checklist-download` event. */
  location: string;
  /** `location` prop for the `get-demo` link in the confirmation. */
  confirmationLocation: string;
  /** Prefix for input ids, so two forms on one page don't collide. */
  idPrefix?: string;
}

const { source, location, confirmationLocation, idPrefix = 'cl' } = Astro.props;

const locale = 'en';
const FORM_NAME = 'sovereign-login-checklist';
const PDF_URL = '/downloads/authgear-sovereign-login-checklist.pdf';
const REVIEW_URL = localizedPath('en', '/schedule-demo?topic=sovereignty-review');

const roles = [
  'CTO or VP Engineering',
  'Engineering or platform lead',
  'Security',
  'Data protection or legal',
  'Other',
];
const id = (name: string) => `${idPrefix}-${name}`;
---

<div class="form-block ds-form checklist__card" data-checklist-card>
  <form
    class="ds-form__form checklist__form"
    name={FORM_NAME}
    method="POST"
    data-netlify="true"
    netlify-honeypot="website"
    data-pdf={PDF_URL}
    data-source={source}
    data-location={location}
  >
    <input type="hidden" name="form-name" value={FORM_NAME} />
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="checklist__honeypot"
    />

    <div class="ds-form__field">
      <label for={id('name')} class="ds-form-label">
        Name<span class="ds-form-label__required">*</span>
      </label>
      <input id={id('name')} class="ds-form-input" name="Name" type="text" required maxlength="256" autocomplete="name" />
    </div>
    <div class="ds-form__field">
      <label for={id('email')} class="ds-form-label">
        Work email<span class="ds-form-label__required">*</span>
      </label>
      <input id={id('email')} class="ds-form-input" name="Email" type="email" required maxlength="256" autocomplete="email" />
    </div>
    <div class="ds-form__field">
      <label for={id('company')} class="ds-form-label">
        Company<span class="ds-form-label__required">*</span>
      </label>
      <input id={id('company')} class="ds-form-input" name="Company" type="text" required maxlength="256" autocomplete="organization" />
    </div>
    <div class="ds-form__field">
      <label for={id('role')} class="ds-form-label">
        Role<span class="ds-form-label__required">*</span>
      </label>
      <select id={id('role')} class="ds-form-input" name="Role" required>
        <option value="" selected disabled>Select one</option>
        {roles.map((r) => <option value={r}>{r}</option>)}
      </select>
    </div>
    <label class="checklist__consent">
      <input type="checkbox" name="marketing-consent" value="yes" />
      <span>Email me related guides now and then. Unsubscribe at any time.</span>
    </label>

    <p class="ds-form-error checklist__error" role="alert" hidden>
      Something went wrong. Please try again.
    </p>
    <button type="submit" class="ds-btn ds-btn-primary ds-form__submit checklist__submit">
      Download the checklist
    </button>
    <p class="checklist__fine">
      The checklist opens in a new tab. We use your details as described in our{' '}
      <a href={localizedPath(locale, '/data-privacy')}>privacy policy</a>.
    </p>
  </form>

  <div class="ds-form-success checklist__success" role="status" hidden>
    <svg class="ds-form-success__icon" aria-hidden="true" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
      <circle cx="24" cy="24" r="22" fill="#d1fae5"></circle>
      <path d="M15 25 L22 32 L34 18" stroke="#047857" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
    </svg>
    <h2 class="ds-form-success__title">Thanks, your checklist is opening in a new tab.</h2>
    <p class="ds-form-success__body checklist__success-body">
      If it doesn't, <a href={PDF_URL} target="_blank" rel="noopener">open the checklist here</a>.
    </p>
    <p class="ds-form-success__body checklist__success-body">
      Want to go through it with us?{' '}
      <a
        href={REVIEW_URL}
        class={`plausible-event-name--get-demo plausible-event-location--${confirmationLocation}`}
      >Book a <span class="checklist__nowrap">30-minute</span> sovereignty review.</a>
    </p>
  </div>
</div>

<script>
  import { trackEvent } from '@/lib/plausible';
  import { pushDataLayer } from '@/lib/gtm';

  document.querySelectorAll<HTMLElement>('[data-checklist-card]').forEach((card) => {
    const form = card.querySelector<HTMLFormElement>('.checklist__form');
    const success = card.querySelector<HTMLElement>('.checklist__success');
    const error = card.querySelector<HTMLElement>('.checklist__error');
    const submit = card.querySelector<HTMLButtonElement>('.checklist__submit');
    if (!form || !success || !error || !submit) return;

    const pdfUrl = form.dataset.pdf ?? '';
    const source = form.dataset.source ?? '';
    const location = form.dataset.location ?? '';
    const submitLabel = submit.textContent?.trim() ?? '';
    let done = false;

    const showSuccess = () => {
      form.hidden = true;
      success.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (done || submit.disabled) return;

      const data = new FormData(form);
      // Bots fill the hidden `website` field. Netlify drops those submissions
      // too, but stopping here keeps them out of Plausible and the dataLayer.
      // The bot sees the normal confirmation and learns nothing.
      if (String(data.get('website') ?? '')) {
        done = true;
        showSuccess();
        return;
      }

      const url = new URLSearchParams(window.location.search);
      const params = new URLSearchParams();
      params.append('form-name', 'sovereign-login-checklist');
      params.append('Name', String(data.get('Name') ?? '').trim());
      params.append('Email', String(data.get('Email') ?? '').trim());
      params.append('Company', String(data.get('Company') ?? '').trim());
      params.append('Role', String(data.get('Role') ?? ''));
      params.append('marketing-consent', data.get('marketing-consent') ? 'yes' : 'no');
      params.append('locale', 'en');
      params.append('source', source);
      params.append('page', window.location.pathname);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign']) {
        const value = url.get(key);
        if (value) params.append(key, value);
      }

      error.hidden = true;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString(),
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        done = true;
        trackEvent('checklist-download', { location });
        // No name, email, company or role: GTM forwards the dataLayer to ad platforms.
        pushDataLayer({ event: 'checklist_download', form_page: window.location.pathname });
        // Browsers (Safari especially) may block a tab opened after an await,
        // so the confirmation always carries a direct link to the PDF too.
        window.open(pdfUrl, '_blank', 'noopener');
        showSuccess();
      } catch {
        error.hidden = false;
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    });
  });
</script>

<style>
  .checklist__card {
    padding: 32px;
    color-scheme: light;
  }
  .checklist__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .checklist__consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 400;
    color: var(--color-text-light-primary);
    cursor: pointer;
  }
  .checklist__consent input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--color-primary-800);
  }
  .checklist__nowrap {
    white-space: nowrap;
  }
  .checklist__submit[disabled] {
    opacity: 0.7;
    cursor: wait;
  }
  .checklist__fine {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-light-secondary);
  }
  .checklist__fine a,
  .checklist__success-body a {
    color: var(--color-primary-800);
    text-decoration: underline;
  }
  /* The design system's success body colour is meant for dark sections. */
  .checklist__success-body {
    color: var(--color-text-light-secondary);
  }
  @media (width < 480px) {
    .checklist__card {
      padding: 24px 20px;
    }
  }
</style>
