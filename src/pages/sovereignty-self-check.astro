---
export const prerender = true;

// UK/EU campaign: a ten-question self-check that leads to the sovereign login
// checklist. Deliberately not under /tools/: retargeting audiences exclude
// /tools/. Answers stay in the browser; only the score band reaches Plausible.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SovereignChecklistForm from '@/components/sovereignty/SovereignChecklistForm.astro';
import SovereigntySelfCheck from '@/components/islands/sovereignty-self-check/SovereigntySelfCheck';
import { localizedPath } from '@/lib/i18n';

const locale = 'en';
const title = 'Login Data Sovereignty Self-Check: 10 Questions, 2 Minutes';
const description =
  "Do you know where your users' login data lives, who can reach it and whether you can leave? Answer 10 questions and see the gaps in 2 minutes.";

const REVIEW_URL = localizedPath(locale, '/schedule-demo?topic=sovereignty-review');
const CHECKLIST_URL = localizedPath(locale, '/sovereign-login-checklist');
const SOVEREIGNTY_URL = localizedPath(locale, '/solutions/data-sovereignty');
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero self-check__hero">
          <p class="self-check__eyebrow">Sovereignty self-check · 10 questions · 2 minutes</p>
          <h1 class="ds-hero-banner__title self-check__title">Who controls your login data?</h1>
          <p class="ds-hero-banner__description self-check__lede">
            Answer ten questions about the login system you run today. You'll see where you're in
            control and where you'd need to find out more. It takes about two minutes, and your
            answers stay in your browser.
          </p>
          <p class="self-check__hero-fine">General guidance, not legal advice.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="self-check__tool">
    <noscript>
      <p class="self-check__noscript">
        Turn on JavaScript to see your result. You can still read the questions below, or{' '}
        <a href="#checklist">get the full checklist</a>.
      </p>
    </noscript>
    <SovereigntySelfCheck client:load />
  </section>

  <section class="self-check__cta" id="checklist">
    <div class="self-check__cta-inner">
      <div class="self-check__cta-copy">
        <p class="self-check__eyebrow self-check__eyebrow--dark">Free PDF · three pages</p>
        <h2 class="self-check__cta-title">Close the gaps: get all 20 questions</h2>
        <p class="self-check__cta-text">
          For each gap above, the checklist shows what a good vendor answer looks like, so you can
          tell a real answer from a vague one. It also adds ten more questions, including
          sub-processors and government requests.
        </p>
        <p class="self-check__review">
          Rather talk it through?{' '}
          <a
            href={REVIEW_URL}
            class="plausible-event-name--get-demo plausible-event-location--self-check"
          >Book a <span class="self-check__nowrap">30-minute</span> sovereignty review</a>.
          We'll go through your answers with you, whether the answer is Authgear or not.
        </p>
        <p class="self-check__authgear">
          Authgear is open-source login software. Self-host it where you choose, or we run a
          private deployment for you in your region.{' '}
          <a href={SOVEREIGNTY_URL}>Data sovereignty with Authgear</a>
        </p>
      </div>
      <SovereignChecklistForm
        source="sovereignty-self-check"
        location="self-check"
        confirmationLocation="self-check-confirmation"
        idPrefix="sc"
      />
    </div>
  </section>

  <section class="self-check__about">
    <div class="self-check__about-grid">
      <div>
        <h2 class="self-check__about-title">What this self-check covers</h2>
        <p>
          Ten questions from <a href={CHECKLIST_URL}>the sovereign login checklist</a>, in five
          groups: where the data sits, who operates it, whose law applies, whether you can leave,
          and who else sees it. A UK or EU data centre answers only the first group.
        </p>
      </div>
      <div>
        <h2 class="self-check__about-title">Who it's for</h2>
        <p>
          CTOs, engineering and platform leads, and security and data protection teams checking
          their own setup, or preparing to ask a vendor.
        </p>
      </div>
    </div>
    <p class="self-check__legal">
      This self-check is general guidance, not legal advice. It doesn't assess whether any setup
      meets a particular law. Talk to your data protection officer or a lawyer about your own
      situation.
    </p>
  </section>
</BaseLayout>

<style>
  .self-check__hero {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
    color: #fff;
  }
  .self-check__title,
  .self-check__lede {
    margin: 0;
    text-align: left;
  }
  .self-check__hero-fine {
    margin: 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
  }
  .self-check__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #9cc0ff;
  }
  .self-check__eyebrow--dark {
    color: var(--color-primary-800);
  }

  .self-check__tool {
    padding: 56px 16px 72px;
    background: #fff;
  }
  .self-check__noscript {
    max-width: 760px;
    margin: 0 auto 32px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--color-bg-light-blue);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-light-primary);
  }

  .self-check__cta {
    padding: 72px 16px;
    background: var(--color-bg-light-blue);
    scroll-margin-top: 140px;
  }
  .self-check__cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }
  .self-check__cta-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .self-check__cta-title {
    margin: 0;
    font-size: 32px;
    line-height: 1.25;
    font-weight: 600;
    color: var(--color-text-light-primary);
  }
  .self-check__cta-text {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-light-secondary);
  }
  .self-check__review {
    margin: 8px 0 0;
    padding: 16px 20px;
    border-radius: 12px;
    background: #fff;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-light-primary);
  }
  .self-check__authgear {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-light-muted);
  }
  .self-check__nowrap {
    white-space: nowrap;
  }

  .self-check__about {
    padding: 64px 16px;
    background: #fff;
  }
  .self-check__about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .self-check__about-title {
    margin: 0 0 12px;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text-light-primary);
  }
  .self-check__about p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-light-secondary);
  }
  .self-check__about p.self-check__legal {
    max-width: 1100px;
    margin: 40px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-border-light-subtle);
    font-size: 13px;
    color: var(--color-text-light-muted);
  }

  .self-check__noscript a,
  .self-check__review a,
  .self-check__authgear a,
  .self-check__about a {
    color: var(--color-primary-800);
    text-decoration: underline;
  }

  @media (width < 992px) {
    .self-check__cta-inner,
    .self-check__about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (width < 480px) {
    .self-check__tool {
      padding: 40px 16px 56px;
    }
    .self-check__cta-title {
      font-size: 26px;
    }
  }
</style>
