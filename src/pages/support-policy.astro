---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import SupportPolicyPage from '@/components/pages/SupportPolicyPage.astro';

const locale = 'en';
const title = t(locale, 'SupportPolicy.title');
const description = t(locale, 'SupportPolicy.description');
---

<BaseLayout locale={locale} title={title} description={description}>
  <SupportPolicyPage locale={locale} />
</BaseLayout>
