---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import SovereignChecklistForm from '@/components/sovereignty/SovereignChecklistForm.astro';

// Gated lead magnet for the UK/EU campaign. The form itself is shared with
// /sovereignty-self-check/ (see SovereignChecklistForm).
const locale = 'en';

const title = 'Sovereign login checklist: 20 questions for your IdP';
const description =
  "20 questions to ask any identity provider about where your users' data lives, who can reach it, and whether you can leave. Free PDF.";

const inside = [
  {
    lead: 'The questions residency misses.',
    rest: 'A UK or EU data centre is only the start. Check who runs the system and whose law applies to them.',
  },
  {
    lead: 'What a good answer looks like.',
    rest: 'For each question, a plain note on what to expect from a vendor, so you can tell a real answer from a vague one.',
  },
  {
    lead: 'The parts teams forget.',
    rest: "Backups, logs, and the email and SMS providers that see your users' phone numbers and one-time codes.",
  },
];

---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero checklist">
          <div class="checklist__copy">
            <h1 class="ds-hero-banner__title checklist__title">The sovereign login checklist</h1>
            <p class="ds-hero-banner__description checklist__lede">
              20 questions to ask any identity provider about where your users' data lives, who can
              reach it, and whether you can leave. Free PDF, three pages.
            </p>
            <h2 class="checklist__inside-title">What's inside</h2>
            <ul class="checklist__inside" role="list">
              {inside.map(({ lead, rest }) => (
                <li>
                  <img src="/images/Checkmark---Iconly-Pro.svg" alt="" width="20" height="20" />
                  <p><strong>{lead}</strong> {rest}</p>
                </li>
              ))}
            </ul>
            <p class="checklist__self-check">
              Not sure where to start?{' '}
              <a href="/sovereignty-self-check/" class="plausible-event-name--self-check-click plausible-event-location--checklist-page">Take the 2-minute self-check.</a>
            </p>
            <p class="checklist__audience">
              For CTOs, engineering and platform leads, and security and data protection teams in
              the UK and Europe.
            </p>
          </div>

          <SovereignChecklistForm
            source="sovereign-login-checklist"
            location="checklist-page"
            confirmationLocation="checklist-confirmation"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .checklist {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .checklist__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    color: #fff;
  }
  .checklist__title,
  .checklist__lede {
    margin: 0;
    text-align: left;
  }
  .checklist__inside-title {
    margin: 12px 0 0;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    color: #fff;
  }
  .checklist__inside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checklist__inside li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .checklist__inside img {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .checklist__inside p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }
  .checklist__inside strong {
    color: #9cc0ff;
    font-weight: 600;
  }
  .checklist__self-check {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }
  .checklist__self-check a {
    color: #9cc0ff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .checklist__audience {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }
  @media (width < 992px) {
    .checklist {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>
