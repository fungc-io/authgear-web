{
  "name": "authgear-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "rm -rf dist",
    "dev": "NODE_ENV=development astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "pretest": "npm run build && (astro dev stop > /dev/null 2>&1 || true) && PUBLIC_GTM_ID=GTM-TEST0000 astro dev --port 4321 --host 0.0.0.0",
    "test": "playwright test",
    "posttest": "if [ -z \"$CI\" ]; then (astro dev stop > /dev/null 2>&1 || true) && npm run dev; fi",
    "test:unit": "vitest run",
    "optimize-images": "node scripts/optimize-content-images.mjs",
    "symlink-zh-images": "node scripts/symlink-zh-hant-images.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.3",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.2.4",
    "bcryptjs": "^3.0.3",
    "hash-wasm": "^4.12.0",
    "intl-tel-input": "^26.9.2",
    "node-addon-api": "^8.7.0",
    "normalize.css": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "scrypt-js": "^3.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.50.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "node-gyp": "^12.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
